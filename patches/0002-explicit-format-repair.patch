+func TestNativeALPExplicitRepairToken(t *testing.T) {
+	r := alpTestRouter(t)
+	ctx := &RequestContext{Headers: map[string]string{":path": "/v1/alp/chat/completions", "authorization": "Bearer repair-caller"}}
+	_, early := r.prepareALPRequest([]byte(`{"model":"cloud/chat","alp":{"catalog_ref":"demo"}}`), ctx)
+	if early != nil {
+		t.Fatal("prepare failed")
+	}
+	ctx.UpstreamStatusCode, ctx.RequestModel = 200, "cloud/chat"
+	res := r.handleALPResponseBody([]byte("recoverable"), ctx).GetResponseBody().GetResponse()
+	body := res.GetBodyMutation().GetBody()
+	token := gjson.GetBytes(body, "alp.provider_state").String()
+	if token == "" || !gjson.GetBytes(body, "alp.format_repair_available").Bool() || bytes.Contains(body, []byte("private")) || gjson.GetBytes(body, "alp.validated").Bool() {
+		t.Fatal("repair state leaked or was accepted")
+	}
+	if _, ok := alpReplay.Get(token, "another-caller"); ok {
+		t.Fatal("foreign caller took state")
+	}
+	saved, ok := alpReplay.Get(token, ctx.alpBinding.scope)
+	if !ok || !bytes.Contains(saved, []byte("private failed output")) {
+		t.Fatal("private provider replay lost")
+	}
+	if _, ok := alpReplay.Get(token, ctx.alpBinding.scope); ok {
+		t.Fatal("repair token reused")
+	}
+}
