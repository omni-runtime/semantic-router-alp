@@ -0,0 +1,77 @@
+package alptransport
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/config"
+)
+
+func TestWorkerProcess(t *testing.T) {
+	if os.Getenv("ALP_WORKER_TEST") != "1" {
+		return
+	}
+	var input map[string]any
+	_ = json.NewDecoder(os.Stdin).Decode(&input)
+	if input["action"] == "wait" {
+		time.Sleep(time.Minute)
+	}
+	if os.Getenv("PROVIDER_API_KEY") != "" {
+		os.Exit(3)
+	}
+	_ = json.NewEncoder(os.Stdout).Encode(map[string]any{"ok": true, "body": map[string]any{"model": "cloud-test"}})
+	os.Exit(0)
+}
+
+func TestALPWorkerBoundaries(t *testing.T) {
+	t.Setenv("ALP_WORKER_TEST", "1")
+	t.Setenv("PROVIDER_API_KEY", "must-not-leak")
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg := config.ALPIntegrationConfig{Enabled: true, Command: []string{exe, "-test.run=^TestWorkerProcess$"}, WorkerEnv: []string{"ALP_WORKER_TEST"}, TimeoutMilliseconds: 1000}
+	result, err := Run(context.Background(), cfg, map[string]any{"action": "prepare"})
+	if err != nil || !result.OK {
+		t.Fatalf("worker failed: %v", err)
+	}
+	cfg.TimeoutMilliseconds = 100
+	if _, err := Run(context.Background(), cfg, map[string]any{"action": "wait"}); err == nil {
+		t.Fatal("worker must time out")
+	}
+	cfg.Command = []string{"relative-command"}
+	if _, err := Run(context.Background(), cfg, map[string]any{}); err == nil {
+		t.Fatal("relative executable accepted")
+	}
+}
+
+func TestALPReplayIsolationExpiryAndCopies(t *testing.T) {
+	var store ReplayStore
+	body := json.RawMessage(`{"messages":[{"role":"assistant","reasoning":"private"}]}`)
+	token, err := store.Put("caller-model-catalog", body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	body[0] = 'X'
+	if _, ok := store.Get(token, "different-caller"); ok {
+		t.Fatal("cross-caller replay accepted")
+	}
+	got, ok := store.Get(token, "caller-model-catalog")
+	if !ok || got[0] != '{' {
+		t.Fatal("history mutated")
+	}
+	got[0] = 'X'
+	again, _ := store.Get(token, "caller-model-catalog")
+	if again[0] != '{' {
+		t.Fatal("get exposed mutable history")
+	}
+	entry := store.entries[token]
+	entry.expires = time.Now().Add(-time.Second)
+	store.entries[token] = entry
+	if _, ok := store.Get(token, "caller-model-catalog"); ok {
+		t.Fatal("expired state accepted")
+	}
+}
