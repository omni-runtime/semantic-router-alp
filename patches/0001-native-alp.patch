diff --git a/src/semantic-router/pkg/alptransport/history.go b/src/semantic-router/pkg/alptransport/history.go
new file mode 100644
index 000000000..4ea3158a2
--- /dev/null
+++ b/src/semantic-router/pkg/alptransport/history.go
@@ -0,0 +1,65 @@
+package alptransport
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"sync"
+	"time"
+)
+
+// ReplayStore holds provider-only messages. Tokens are scoped to the authenticated
+// caller, logical model and catalog; expiration or process restart fails closed.
+type ReplayStore struct {
+	mu      sync.Mutex
+	entries map[string]replayEntry
+	bytes   int
+}
+type replayEntry struct {
+	scope   string
+	history json.RawMessage
+	expires time.Time
+}
+
+var errHistoryLimit = errors.New("ALP replay store capacity exceeded")
+
+const maxHistoryBytes = 32 * 1024 * 1024
+
+func (s *ReplayStore) Get(token, scope string) (json.RawMessage, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e, ok := s.entries[token]
+	if !ok || e.scope != scope || !time.Now().Before(e.expires) {
+		return nil, false
+	}
+	return append(json.RawMessage(nil), e.history...), true
+}
+
+func (s *ReplayStore) Put(scope string, history json.RawMessage) (string, error) {
+	if len(history) > 8*1024*1024 {
+		return "", errHistoryLimit
+	}
+	var id [32]byte
+	if _, err := rand.Read(id[:]); err != nil {
+		return "", err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.entries == nil {
+		s.entries = make(map[string]replayEntry)
+	}
+	for key, entry := range s.entries {
+		if !time.Now().Before(entry.expires) {
+			s.bytes -= len(entry.history)
+			delete(s.entries, key)
+		}
+	}
+	if len(s.entries) >= 256 || s.bytes+len(history) > maxHistoryBytes {
+		return "", errHistoryLimit
+	}
+	token := hex.EncodeToString(id[:])
+	s.entries[token] = replayEntry{scope, append(json.RawMessage(nil), history...), time.Now().Add(30 * time.Minute)}
+	s.bytes += len(history)
+	return token, nil
+}
diff --git a/src/semantic-router/pkg/alptransport/worker.go b/src/semantic-router/pkg/alptransport/worker.go
new file mode 100644
index 000000000..0a69c240a
--- /dev/null
+++ b/src/semantic-router/pkg/alptransport/worker.go
@@ -0,0 +1,90 @@
+// Package alptransport bridges SR to an operator-installed authoritative ALP validator.
+// It contains no private ALP schemas, provider HTTP client, or action executor.
+package alptransport
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"time"
+
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/config"
+)
+
+const MaxBytes = 16 * 1024 * 1024
+
+var slots = make(chan struct{}, 8)
+
+type Result struct {
+	OK       bool            `json:"ok"`
+	Status   int             `json:"status"`
+	Error    json.RawMessage `json:"error"`
+	Body     json.RawMessage `json:"body"`
+	Context  json.RawMessage `json:"context"`
+	Response json.RawMessage `json:"response"`
+	History  json.RawMessage `json:"history"`
+	Stream   bool            `json:"stream"`
+}
+
+type boundedOutput struct{ bytes.Buffer }
+
+func (b *boundedOutput) Write(p []byte) (int, error) {
+	if b.Len()+len(p) > MaxBytes {
+		return 0, errors.New("ALP worker output limit")
+	}
+	return b.Buffer.Write(p)
+}
+
+func Run(ctx context.Context, cfg config.ALPIntegrationConfig, input any) (Result, error) {
+	var result Result
+	if !cfg.Enabled || len(cfg.Command) == 0 || !filepath.IsAbs(cfg.Command[0]) {
+		return result, errors.New("ALP worker is not configured with an absolute executable")
+	}
+	timeout := cfg.TimeoutMilliseconds
+	if timeout == 0 {
+		timeout = 10000
+	}
+	if timeout < 100 || timeout > 60000 {
+		return result, errors.New("ALP worker timeout is invalid")
+	}
+	ctx, cancel := context.WithTimeout(ctx, time.Duration(timeout)*time.Millisecond)
+	defer cancel()
+	select {
+	case slots <- struct{}{}:
+		defer func() { <-slots }()
+	case <-ctx.Done():
+		return result, ctx.Err()
+	}
+	body, err := json.Marshal(input)
+	if err != nil || len(body) > MaxBytes {
+		return result, errors.New("ALP worker input limit")
+	}
+	// #nosec G204 -- argv comes only from operator configuration, never from HTTP or model input.
+	cmd := exec.CommandContext(ctx, cfg.Command[0], cfg.Command[1:]...)
+	// Provider credentials and the router environment are not inherited.
+	cmd.Env = []string{"PATH=/usr/local/bin:/usr/bin:/bin", "PYTHONUNBUFFERED=1", "PYTHONDONTWRITEBYTECODE=1"}
+	for _, key := range cfg.WorkerEnv {
+		if value, ok := os.LookupEnv(key); ok {
+			cmd.Env = append(cmd.Env, key+"="+value)
+		}
+	}
+	cmd.Stdin = bytes.NewReader(body)
+	var stdout boundedOutput
+	cmd.Stdout, cmd.Stderr = &stdout, io.Discard
+	cmd.WaitDelay = time.Second
+	if err := cmd.Run(); err != nil {
+		return result, errors.New("ALP worker unavailable")
+	}
+	if err := json.Unmarshal(stdout.Bytes(), &result); err != nil {
+		return result, errors.New("invalid ALP worker response")
+	}
+	if !result.OK && (result.Status < 400 || result.Status > 599 || len(result.Error) == 0) {
+		return result, errors.New("invalid ALP worker error")
+	}
+	return result, nil
+}
diff --git a/src/semantic-router/pkg/alptransport/worker_test.go b/src/semantic-router/pkg/alptransport/worker_test.go
