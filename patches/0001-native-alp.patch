+package config
+
+import (
+	"testing"
+
+	"gopkg.in/yaml.v2"
+)
+
+func TestALPCanonicalRoundTrip(t *testing.T) {
+	var global CanonicalGlobal
+	if err := yaml.Unmarshal([]byte(`integrations:
+  alp:
+    enabled: true
+    command: [/opt/alp/bin/python, -m, semantic_router_alp.cloud_worker, --config, /etc/alp/catalogs.json]
+    worker_env: [ALP_HOST_TASK_KEY]
+    timeout_milliseconds: 5000
+    models:
+      cloud/chat:
+        enable_thinking: false
+        allow_stop_tool_call: true
+`), &global); err != nil {
+		t.Fatal(err)
+	}
+	var runtime RouterConfig
+	applyCanonicalIntegrationGlobal(&runtime, global.Integrations)
+	if !runtime.ALP.Enabled || len(runtime.ALP.Command) != 5 {
+		t.Fatal("ALP config lost")
+	}
+	policy := runtime.ALP.Models["cloud/chat"]
+	if policy.EnableThinking == nil || *policy.EnableThinking || !policy.AllowStopToolCall {
+		t.Fatal("provider policy lost")
+	}
+	encoded, err := yaml.Marshal(global)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var replay CanonicalGlobal
+	if err := yaml.Unmarshal(encoded, &replay); err != nil || !replay.Integrations.ALP.Enabled {
+		t.Fatal("canonical replay failed")
+	}
+}
