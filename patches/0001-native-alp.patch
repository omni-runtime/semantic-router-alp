+func TestNativeALPDuplicateHeaders(t *testing.T) {
+	for _, key := range []string{"x-alp-task-context", "x-alp-provider-state", "authorization"} {
+		for _, coalesced := range []bool{false, true} {
+			v := newRequestHeaders("POST", "/v1/alp/chat/completions")
+			v.RequestHeaders.Headers.Headers = append(v.RequestHeaders.Headers.Headers,
+				&core.HeaderValue{Key: key, RawValue: []byte("first")})
+			if coalesced {
+				v.RequestHeaders.Headers.Headers[len(v.RequestHeaders.Headers.Headers)-1].RawValue = []byte("first,second")
+			} else {
+				v.RequestHeaders.Headers.Headers = append(v.RequestHeaders.Headers.Headers,
+					&core.HeaderValue{Key: key, RawValue: []byte("second")})
+			}
+			ctx := &RequestContext{Headers: map[string]string{}}
+			response, err := alpTestRouter(t).handleRequestHeaders(v, ctx)
+			if err != nil || response.GetImmediateResponse().GetStatus().GetCode() != 403 {
+				t.Fatalf("duplicate %s was not rejected: %v", key, err)
+			}
+		}
+	}
+}
