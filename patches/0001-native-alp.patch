+func TestNativeALPTransportEdge(t *testing.T) {
+	r := alpTestRouter(t)
+	ctx := &RequestContext{Headers: map[string]string{":path": "/v1/alp/chat/completions", "authorization": "Bearer caller"}}
+	request, early := r.prepareProtocolRequest([]byte(`{"model":"cloud/chat","messages":[],"stream":true,"alp":{"catalog_ref":"demo"}}`), ctx)
+	if early != nil || request == nil || ctx.alpBinding == nil || request.Stream {
+		t.Fatal("ALP ingress projection failed")
+	}
+	if !ctx.CacheReadBypass || !ctx.CacheWriteBypass {
+		t.Fatal("ALP cache not bypassed")
+	}
+	dispatch := &providerDispatch{logicalModel: "cloud/chat", targetFormat: llmprotocol.OpenAIChatV1}
+	body, err := r.adaptALPDispatch([]byte(`{"max_completion_tokens":123}`), dispatch, ctx)
+	if err != nil || gjson.GetBytes(body, "enable_thinking").Bool() || !gjson.GetBytes(body, "enable_thinking").Exists() || gjson.GetBytes(body, "max_tokens").Int() != 123 {
+		t.Fatal("provider policy not applied")
+	}
+	ctx.UpstreamStatusCode = 200
+	ctx.RequestModel = "cloud/chat"
+	response := r.handleALPResponseBody([]byte(`{}`), ctx)
+	mut := response.GetResponseBody().GetResponse().GetBodyMutation().GetBody()
+	if len(mut) == 0 || string(mut[:6]) != "data: " {
+		t.Fatal("buffered ALP SSE missing")
+	}
+	if bytes.Contains(mut, []byte("private")) || bytes.Contains(mut, []byte("reasoning")) {
+		t.Fatal("private history leaked")
+	}
+	failure := r.handleALPResponseBody([]byte("invalid"), ctx).GetResponseBody().GetResponse()
+	if !bytes.Contains(failure.GetBodyMutation().GetBody(), []byte("INVALID_ALP_OUTPUT")) {
+		t.Fatal("ALP error code was lost")
+	}
+	foundStatus := false
+	for _, h := range failure.GetHeaderMutation().GetSetHeaders() {
+		if h.Header.Key == ":status" && string(h.Header.RawValue) == "502" {
+			foundStatus = true
+		}
+	}
+	if !foundStatus {
+		t.Fatal("buffered validation error must change HTTP status")
+	}
+	if r.shouldAttemptFallback(ctx) {
+		t.Fatal("ALP must not trigger hidden model retries")
+	}
+}
