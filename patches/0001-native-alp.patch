+func TestNativeALPDisabledUnknownAndForeignReplay(t *testing.T) {
+	r := alpTestRouter(t)
+	ctx := &RequestContext{Headers: map[string]string{":path": "/v1/alp/chat/completions", "authorization": "Bearer caller"}}
+	body := []byte(`{"model":"cloud/chat","alp":{"catalog_ref":"demo"}}`)
+	ctx.Headers["x-alp-provider-state"] = "unknown"
+	_, early := r.prepareALPRequest(body, ctx)
+	if early.GetImmediateResponse().GetStatus().GetCode() != 409 {
+		t.Fatal("foreign state accepted")
+	}
+	delete(ctx.Headers, "x-alp-provider-state")
+	delete(ctx.Headers, "authorization")
+	_, early = r.prepareALPRequest(body, ctx)
+	if early.GetImmediateResponse().GetStatus().GetCode() != 401 {
+		t.Fatal("unauthenticated replay enabled")
+	}
+	r.Config.ALP.Enabled = false
+	_, early = r.prepareALPRequest(body, ctx)
+	if early.GetImmediateResponse().GetStatus().GetCode() != 404 {
+		t.Fatal("disabled transport accepted")
+	}
+	if r.validateRequestHeaders("POST", "/v1/alp/chat/completions") != nil {
+		t.Fatal("ALP route missing")
+	}
+	if r.validateRequestHeaders("GET", "/v1/alp/chat/completions").GetImmediateResponse().GetStatus().GetCode() != 405 {
+		t.Fatal("ALP method check missing")
+	}
+}
