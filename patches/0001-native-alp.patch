diff --git a/src/semantic-router/pkg/extproc/processor_alp.go b/src/semantic-router/pkg/extproc/processor_alp.go
new file mode 100644
index 000000000..196498d07
--- /dev/null
+++ b/src/semantic-router/pkg/extproc/processor_alp.go
@@ -0,0 +1,224 @@
+package extproc
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"strconv"
+	"strings"
+
+	core "github.com/envoyproxy/go-control-plane/envoy/config/core/v3"
+	http_ext "github.com/envoyproxy/go-control-plane/envoy/extensions/filters/http/ext_proc/v3"
+	ext_proc "github.com/envoyproxy/go-control-plane/envoy/service/ext_proc/v3"
+	"github.com/tidwall/sjson"
+
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/alptransport"
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/config"
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/headers"
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/llmprotocol"
+)
+
+type alpRequestBinding struct {
+	context       json.RawMessage
+	scope         string
+	stream        bool
+	policy        config.ALPModelPolicy
+	expectedModel string
+}
+
+var alpReplay alptransport.ReplayStore
+
+// Inspect raw headers before the map representation can discard duplicates.
+// Comma-coalesced copies are invalid too: these fields are singleton tokens.
+func duplicateALPHeader(v *ext_proc.ProcessingRequest_RequestHeaders) bool {
+	seen := map[string]bool{}
+	for _, h := range v.RequestHeaders.Headers.Headers {
+		key := strings.ToLower(h.Key)
+		if key != "x-alp-task-context" && key != "x-alp-provider-state" && key != "authorization" {
+			continue
+		}
+		if seen[key] || strings.Contains(extractHeaderValue(h), ",") {
+			return true
+		}
+		seen[key] = true
+	}
+	return false
+}
+
+func (r *OpenAIRouter) prepareALPRequest(body []byte, ctx *RequestContext) ([]byte, *ext_proc.ProcessingResponse) {
+	if normalizeRequestPath(ctx.Headers[":path"]) != "/v1/alp/chat/completions" {
+		return body, nil
+	}
+	if r.Config == nil || !r.Config.ALP.Enabled {
+		return nil, r.createErrorResponse(404, "ALP transport is disabled")
+	}
+	if ctx.SkipProcessing || len(body) > 8*1024*1024 {
+		return nil, r.createErrorResponse(400, "invalid ALP transport request")
+	}
+	var identity struct {
+		Model  string `json:"model"`
+		Stream bool   `json:"stream"`
+		ALP    struct {
+			Catalog string `json:"catalog_ref"`
+		} `json:"alp"`
+	}
+	if json.Unmarshal(body, &identity) != nil {
+		return nil, r.createErrorResponse(400, "invalid ALP request")
+	}
+	_, enabledModel := r.Config.ALP.Models[identity.Model]
+	if !enabledModel && !r.requestModelActsAsAuto(identity.Model) {
+		return nil, r.createErrorResponse(400, "ALP requires a public entrypoint or an explicitly enabled model")
+	}
+	auth := headerValueCI(ctx, "authorization")
+	if auth == "" {
+		return nil, r.createErrorResponse(401, "ALP requires caller authentication for private replay")
+	}
+	scopeBytes, _ := json.Marshal([]string{auth, identity.Model, identity.ALP.Catalog, fmt.Sprint(r.Config.ALP.Command)})
+	digest := sha256.Sum256(scopeBytes)
+	scope := hex.EncodeToString(digest[:])
+	input := map[string]any{"action": "prepare", "body": string(body), "headers": map[string]string{}}
+	expectedModel := ""
+	if value := headerValueCI(ctx, "x-alp-task-context"); value != "" {
+		input["headers"] = map[string]string{"x-alp-task-context": value}
+	}
+	if token := headerValueCI(ctx, "x-alp-provider-state"); token != "" {
+		history, ok := alpReplay.Get(token, scope)
+		if !ok {
+			return nil, r.createErrorResponse(409, "ALP provider state is expired or belongs to another caller, model or catalog")
+		}
+		var saved struct {
+			Model   string          `json:"model"`
+			History json.RawMessage `json:"history"`
+		}
+		if json.Unmarshal(history, &saved) != nil || saved.Model == "" || len(saved.History) == 0 {
+			return nil, r.createErrorResponse(409, "invalid ALP provider state")
+		}
+		expectedModel = saved.Model
+		input["history"] = saved.History
+	}
+	result, err := alptransport.Run(selectionRequestContext(ctx), r.Config.ALP, input)
+	if err != nil {
+		return nil, r.createErrorResponse(503, "ALP contract worker unavailable")
+	}
+	if !result.OK {
+		return nil, r.alpWorkerError(result)
+	}
+	if len(result.Context) == 0 || len(result.Body) == 0 {
+		return nil, r.createErrorResponse(503, "invalid ALP worker projection")
+	}
+	ctx.alpBinding = &alpRequestBinding{context: result.Context, scope: scope, stream: identity.Stream, expectedModel: expectedModel}
+	ctx.CacheReadBypass, ctx.CacheWriteBypass = true, true
+	ctx.ExpectStreamingResponse = false // Provider response is buffered until validation.
+	return result.Body, nil
+}
+
+func (r *OpenAIRouter) alpWorkerError(result alptransport.Result) *ext_proc.ProcessingResponse {
+	body, _ := json.Marshal(map[string]json.RawMessage{"error": result.Error})
+	return r.createJSONResponseWithBody(result.Status, body, headers.ResponsePathError)
+}
+
+func (r *OpenAIRouter) adaptALPDispatch(body []byte, dispatch *providerDispatch, ctx *RequestContext) ([]byte, error) {
+	if ctx == nil || ctx.alpBinding == nil {
+		return body, nil
+	}
+	if dispatch == nil || dispatch.targetFormat != llmprotocol.OpenAIChatV1 {
+		return nil, fmt.Errorf("ALP requires an OpenAI Chat Function Calling backend")
+	}
+	policy, ok := r.Config.ALP.Models[dispatch.logicalModel]
+	if !ok {
+		return nil, fmt.Errorf("selected model is not enabled for ALP")
+	}
+	if ctx.alpBinding.expectedModel != "" && ctx.alpBinding.expectedModel != dispatch.logicalModel {
+		return nil, fmt.Errorf("ALP replay cannot switch the provider model")
+	}
+	ctx.alpBinding.policy = policy
+	var err error
+	if policy.EnableThinking != nil {
+		body, err = sjson.SetBytes(body, "enable_thinking", *policy.EnableThinking)
+	}
+	if err != nil {
+		return nil, err
+	}
+	// The compatible Qwen endpoint consumes max_tokens, not max_completion_tokens.
+	var fields map[string]json.RawMessage
+	if err := json.Unmarshal(body, &fields); err != nil {
+		return nil, err
+	}
+	if value, ok := fields["max_completion_tokens"]; ok {
+		fields["max_tokens"] = value
+		delete(fields, "max_completion_tokens")
+	}
+	return json.Marshal(fields)
+}
+
+func (r *OpenAIRouter) handleALPResponseBody(body []byte, ctx *RequestContext) (response *ext_proc.ProcessingResponse) {
+	defer func() {
+		// ALP explicitly buffers the provider body. Change the buffered status and
+		// body together; an ImmediateResponse after headers can reset the stream.
+		if immediate := response.GetImmediateResponse(); immediate != nil {
+			mutation := &ext_proc.HeaderMutation{RemoveHeaders: []string{"content-length"}, SetHeaders: []*core.HeaderValueOption{
+				{Header: &core.HeaderValue{Key: ":status", RawValue: []byte(strconv.Itoa(int(immediate.GetStatus().GetCode())))}},
+				{Header: &core.HeaderValue{Key: "content-type", RawValue: []byte("application/json")}},
+			}}
+			response = buildResponseBodyContinueResponse(&ext_proc.BodyMutation{Mutation: &ext_proc.BodyMutation_Body{Body: immediate.Body}}, mutation)
+		}
+	}()
+	if ctx.UpstreamStatusCode < 200 || ctx.UpstreamStatusCode >= 300 {
+		return r.createErrorResponse(ctx.UpstreamStatusCode, "ALP provider request failed")
+	}
+	result, err := alptransport.Run(selectionRequestContext(ctx), r.Config.ALP, map[string]any{
+		"action": "complete", "body": string(body), "context": ctx.alpBinding.context,
+		"allow_stop_tool_call": ctx.alpBinding.policy.AllowStopToolCall,
+	})
+	if err != nil {
+		return r.createErrorResponse(503, "ALP contract worker unavailable")
+	}
+	if !result.OK {
+		return r.alpWorkerError(result)
+	}
+	if len(result.Response) == 0 || len(result.History) == 0 {
+		return r.createErrorResponse(502, "incomplete ALP worker response")
+	}
+	saved, err := json.Marshal(map[string]any{"model": ctx.RequestModel, "history": result.History})
+	if err != nil {
+		return r.createErrorResponse(502, "invalid ALP provider history")
+	}
+	token, err := alpReplay.Put(ctx.alpBinding.scope, saved)
+	if err != nil {
+		return r.createErrorResponse(503, "ALP replay capacity unavailable")
+	}
+	body, err = sjson.SetBytes(result.Response, "alp.provider_state", token)
+	if err != nil {
+		return r.createErrorResponse(502, "invalid ALP response")
+	}
+	contentType := "application/json"
+	if ctx.alpBinding.stream {
+		// SSE represents a validated buffered completion. No fake token deltas.
+		var response map[string]any
+		if json.Unmarshal(body, &response) != nil {
+			return r.createErrorResponse(502, "invalid ALP response")
+		}
+		event, _ := json.Marshal(map[string]any{"type": "agent_call.completed", "response": response})
+		body = append(append([]byte("data: "), event...), []byte("\n\ndata: [DONE]\n\n")...)
+		contentType = "text/event-stream"
+	}
+	return buildResponseBodyContinueResponse(&ext_proc.BodyMutation{Mutation: &ext_proc.BodyMutation_Body{Body: body}},
+		&ext_proc.HeaderMutation{RemoveHeaders: []string{"content-length"}, SetHeaders: []*core.HeaderValueOption{{
+			Header: &core.HeaderValue{Key: "content-type", RawValue: []byte(contentType)},
+		}}})
+}
+
+func alpResponseHeaders(ctx *RequestContext) *ext_proc.HeaderMutation {
+	contentType := "application/json"
+	if ctx.alpBinding.stream {
+		contentType = "text/event-stream"
+	}
+	return &ext_proc.HeaderMutation{RemoveHeaders: []string{"content-length"}, SetHeaders: []*core.HeaderValueOption{{Header: &core.HeaderValue{Key: "content-type", RawValue: []byte(contentType)}}}}
+}
+
+func alpBufferedResponseHeaders(ctx *RequestContext) *ext_proc.ProcessingResponse {
+	response := buildResponseHeadersContinueResponse(alpResponseHeaders(ctx), false)
+	response.ModeOverride = &http_ext.ProcessingMode{ResponseBodyMode: http_ext.ProcessingMode_BUFFERED}
+	return response
+}
