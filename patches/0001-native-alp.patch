+		result["response"] = json.RawMessage(`{"object":"alp.chat.completion","choices":[],"alp":{"validated":true,"executed":false}}`)
+		result["history"] = json.RawMessage(`{"messages":[{"role":"assistant","reasoning":"private"}]}`)
+	}
+	_ = json.NewEncoder(os.Stdout).Encode(result)
+	os.Exit(0)
