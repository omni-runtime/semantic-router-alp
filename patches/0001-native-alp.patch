+func TestNativeALPEntrypointAndSelectedModelPolicy(t *testing.T) {
+	r := alpTestRouter(t)
+	r.Config.RequireEntrypoint = true
+	r.Config.AutoModelNames = []string{"cloud-only"}
+	ctx := &RequestContext{Headers: map[string]string{":path": "/v1/alp/chat/completions", "authorization": "Bearer caller"}}
+	request, early := r.prepareProtocolRequest([]byte(`{"model":"cloud-only","alp":{"catalog_ref":"demo"}}`), ctx)
+	if early != nil || request.Model != "cloud-only" {
+		t.Fatal("ALP public entrypoint was not preserved")
+	}
+	_, err := r.adaptALPDispatch([]byte(`{}`), &providerDispatch{logicalModel: "not-enabled", targetFormat: llmprotocol.OpenAIChatV1}, ctx)
+	if err == nil {
+		t.Fatal("selected backend escaped the ALP allowlist")
+	}
+	ctx.alpBinding.expectedModel = "another-model"
+	_, err = r.adaptALPDispatch([]byte(`{}`), &providerDispatch{logicalModel: "cloud/chat", targetFormat: llmprotocol.OpenAIChatV1}, ctx)
+	if err == nil {
+		t.Fatal("private replay switched provider models")
+	}
+	_, early = r.prepareProtocolRequest([]byte(`{"model":"cloud/chat","alp":{"catalog_ref":"demo"}}`), &RequestContext{Headers: ctx.Headers})
+	if early.GetImmediateResponse().GetStatus().GetCode() != 400 {
+		t.Fatal("global entrypoint policy was bypassed")
+	}
+}
