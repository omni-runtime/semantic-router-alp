+func TestNativeALPProviderErrorStatus(t *testing.T) {
+	for _, code := range []int{401, 429, 502, 503, 504} {
+		ctx := &RequestContext{UpstreamStatusCode: code, alpBinding: &alpRequestBinding{}}
+		result := alpTestRouter(t).handleALPResponseBody([]byte(`{}`), ctx)
+		mutation := result.GetResponseBody().GetResponse().GetHeaderMutation()
+		found := false
+		for _, h := range mutation.GetSetHeaders() {
+			if h.Header.Key == ":status" {
+				found = string(h.Header.RawValue) == fmt.Sprint(code)
+			}
+		}
+		if !found {
+			t.Fatalf("provider HTTP %d changed to another status", code)
+		}
+	}
+}
