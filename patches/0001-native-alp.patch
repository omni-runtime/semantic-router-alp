+func TestALPExtProcWorkerProcess(t *testing.T) {
+	if os.Getenv("ALP_EXTPROC_TEST") != "1" {
+		return
+	}
+	var input map[string]json.RawMessage
+	_ = json.NewDecoder(os.Stdin).Decode(&input)
+	var action string
+	_ = json.Unmarshal(input["action"], &action)
+	result := map[string]any{"ok": true}
+	if action == "prepare" {
+		result["context"] = map[string]any{"private": "state"}
+		result["body"] = json.RawMessage(`{"model":"cloud/chat","messages":[{"role":"user","content":"call the agent"}],"tools":[{"type":"function","function":{"name":"alp_agent_call","parameters":{"type":"object","properties":{},"additionalProperties":false}}}],"tool_choice":{"type":"function","function":{"name":"alp_agent_call"}},"parallel_tool_calls":false,"stream":false}`)
+		var source string
+		_ = json.Unmarshal(input["body"], &source)
+		var projected map[string]json.RawMessage
+		_ = json.Unmarshal(result["body"].(json.RawMessage), &projected)
+		projected["model"], _ = json.Marshal(gjson.Get(source, "model").String())
+		result["body"] = projected
+	} else {
+		var body string
+		_ = json.Unmarshal(input["body"], &body)
+		if body == "invalid" {
+			_ = json.NewEncoder(os.Stdout).Encode(map[string]any{"ok": false, "status": 502, "error": map[string]any{"type": "alp_error", "code": "INVALID_ALP_OUTPUT", "message": "Invalid output."}})
